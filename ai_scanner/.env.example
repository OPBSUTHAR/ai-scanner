# ============================================
# AI Scanner - Environment Variables
# COPY THIS FILE AS .env AND FILL IN YOUR KEYS
# NEVER commit this file to GitHub!
# ============================================

# --- Google Drive API ---
# Get these from https://console.cloud.google.com/apis/credentials
# Easiest: download the OAuth client JSON for a WEB APPLICATION and drop it
# in the project root — any file named credentials*.json or client_secret_*.json
# is auto-detected (newest wins) e.g. credentials-googleDriveNew.json.
# The redirect URI below MUST be registered in the Google Console:
# http://localhost:5000/auth/google/callback  (NO trailing slash)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# --- Google Cloud Vision (OCR) ---
# Service account JSON path or key
GOOGLE_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# --- Dropbox API ---
# Get from https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=

# --- OneDrive / Microsoft Graph API ---
# Get from https://portal.azure.com -> App Registrations
# 1. New registration (accounts any type OK) -> note Application (client) ID
# 2. Certificates & secrets -> New client secret -> copy the VALUE (shown once)
# 3. Authentication -> Redirect URIs (Web) -> add the EXACT URI below
#    (http://localhost is allowed in http form; register it verbatim, no trailing slash)
# 4. API permissions -> add Microsoft Graph -> Delegated -> Files.ReadWrite.All
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=
ONEDRIVE_REDIRECT_URI=http://localhost:5000/cloud/callback/onedrive

# --- App Configuration ---
APP_ENV=development
APP_DEBUG=True
DATA_DIR=./data
LOG_LEVEL=INFO
