# ============================================
# AI Scanner - Environment Variables
# COPY THIS FILE AS .env AND FILL IN YOUR KEYS
# NEVER commit this file to GitHub!
# ============================================

# --- Google Drive API ---
# Get these from https://console.cloud.google.com/apis/credentials
# Easiest: download the OAuth client JSON for a WEB APPLICATION and drop it
# in the project root — any file named credentials*.json or client_secret_*.json
# is auto-detected (newest wins) e.g. credentials-googleDriveNew.json.
# The redirect URI below MUST be registered in the Google Console:
# http://localhost:5000/auth/google/callback  (NO trailing slash)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# --- Google Cloud Vision (OCR) ---
# Service account JSON path or key
GOOGLE_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# --- Dropbox API ---
# Get from https://www.dropbox.com/developers/apps
# IMPORTANT: in the app console -> Permissions -> Redirect URIs, add the EXACT
# URI below so login redirects straight back to the app (no paste-code step).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=
DROPBOX_REDIRECT_URI=http://localhost:5000/cloud/callback/dropbox

# --- OneDrive / Microsoft Graph API ---
# Get from https://portal.azure.com -> App Registrations
# 1. New registration (accounts any type OK) -> note Application (client) ID
# 2. Certificates & secrets -> New client secret -> copy the VALUE (shown once)
# 3. Authentication -> Redirect URIs (Web) -> add the EXACT URI below
#    (http://localhost is allowed in http form; register it verbatim, no trailing slash)
# 4. API permissions -> add Microsoft Graph -> Delegated -> Files.ReadWrite.All
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=
ONEDRIVE_REDIRECT_URI=http://localhost:5000/cloud/callback/onedrive

# --- AI Assistant (FREE — no API keys needed for basic mode) ---
# Provider chain: Ollama -> Cloud LLM -> Transformers -> Built-in helper.
# Option 1 (best local quality): install Ollama from https://ollama.com then:
#   ollama pull llama3.2        (any model works: phi3, gemma2, mistral, qwen2.5...)
#   The app auto-detects Ollama and uses it automatically.
OLLAMA_HOST=http://localhost:11434
# Optional: force a specific Ollama model (leave empty = auto-pick)
OLLAMA_MODEL=
# Option 2 (hosted deploys like Render/Railway/Coolify): free cloud LLM so ALL
# visitors get full chat quality with zero setup. Create a free API key at
# https://console.groq.com (generous free tier, no credit card) and paste it:
GROQ_API_KEY=
# Optional overrides (defaults: Groq endpoint + llama-3.3-70b-versatile).
# Works with ANY OpenAI-compatible provider (Groq, Gemini openai-compat, OpenRouter...)
CLOUD_AI_BASE_URL=https://api.groq.com/openai/v1
CLOUD_AI_MODEL=llama-3.3-70b-versatile
# Option 3 (no extra software): open-source flan-t5-small runs via transformers;
# the ~300MB model is downloaded once on first use, then fully offline.
AI_LOCAL_MODEL=google/flan-t5-small

# --- App Configuration ---
APP_ENV=development
APP_DEBUG=True
DATA_DIR=./data
LOG_LEVEL=INFO
