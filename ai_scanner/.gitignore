# Environment variables (CONTAINS SECRETS - NEVER COMMIT)
.env

# Fernet key for API key encryption (regenerated on first run)
src/data/.key_enc

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# IDE & editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
Thumbs.db
.DS_Store

# Data directory (user data, temp files)
data/*

# Model files (can be large)
models/
*.pth
*.pt
*.h5
*.onnx

# Logs (auto-generated)
log_file.txt
diary_log.txt
server_*.log

# Service account keys (JSON credentials) — keep deploy json tracked
*.json
!secrets/example.json
!railway.json

# Google OAuth client credentials — NEVER commit
credentials-google-drive.json
client_secret_*.json

# Virtual environment
venv/
.venv/
env/

# Tokens (from cloud auth)
tokens/
